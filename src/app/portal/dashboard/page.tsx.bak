"use client"

import { Card, CardContent, CardHeader, CardTitle, CardDescription, CardStat } from "@/components/ui/card"
import { createClient } from "@/lib/supabase/client"
import { getUserRolesClient } from "@/lib/auth.client"
import { Role } from "@/types"
import { useEffect, useState } from "react"
import Link from "next/link"
import { Badge } from "@/components/ui/badge"
import { Button } from "@/components/ui/button"
import {
  FileText,
  ShoppingCart,
  RefreshCw,
  Calendar,
  Clock,
  CheckCircle,
  TrendingUp,
  ArrowRight,
  Sparkles,
  HelpCircle,
  AlertCircle,
  ChevronRight,
  Building2,
  DollarSign
} from "lucide-react"

type BudgetStatus = {
  total: number
  used: number
  remaining: number
}

type RecentActivity = {
  id: string
  type: "budget" | "purchase" | "refund" | "program"
  title: string
  status: string
  date: string
  link: string
}

type PendingItem = {
  id: string
  type: "purchase" | "refund" | "program"
  title: string
  status: string
  date: string
  link: string
}

export default function PortalDashboard() {
  const supabase = createClient()
  const [roles, setRoles] = useState<Role[]>([])
  const [companyName, setCompanyName] = useState<string | null>(null)
  const [companyId, setCompanyId] = useState<string | null>(null)
  const [loading, setLoading] = useState(true)

  const [stats, setStats] = useState<{
    budget: number
    purchase: number
    refund: number
    programs: number
  }>({ budget: 0, purchase: 0, refund: 0, programs: 0 })
  const [recentActivities, setRecentActivities] = useState<RecentActivity[]>([])
  const [budgetStatus, setBudgetStatus] = useState<BudgetStatus | null>(null)
  const [pendingItems, setPendingItems] = useState<PendingItem[]>([])

  useEffect(() => {
    const init = async () => {
      const userRoles = await getUserRolesClient()
      setRoles(userRoles)

      let currentCompanyId: string | null = null

      if (userRoles.includes(Role.COMPANY_USER)) {
        const company = await getPrimaryCompany()
        setCompanyName(company?.name || null)
        currentCompanyId = company?.id || null
        setCompanyId(currentCompanyId)
      }

      if (currentCompanyId) {
        await fetchDashboardData(currentCompanyId)
      } else {
        setLoading(false)
      }
    }
    init()
  }, [])

  const getPrimaryCompany = async () => {
    const { data: { user } } = await supabase.auth.getUser()
    if (!user) return null

    const { data } = await supabase
      .from("user_companies")
      .select(`
        company_id,
        companies (*)
      `)
      .eq("user_id", user.id)
      .eq("is_primary", true)
      .single()

    const companies = data?.companies as any
    return Array.isArray(companies) ? companies[0] : companies
  }

  const fetchDashboardData = async (companyId: string) => {
    try {
      const currentYear = new Date().getFullYear()

      // 예산 통계
      const { data: budgets } = await supabase
        .from("budgets")
        .select("id, status, total_amount")
        .eq("company_id", companyId)
        .eq("fiscal_year", currentYear)
        .is("deleted_at", null)

      const approvedBudgets = budgets?.filter(b => b.status === "approved") || []
      const totalBudget = approvedBudgets.reduce((sum, b) => sum + (b.total_amount || 0), 0)

      // 구매요청 통계
      const { data: purchases } = await supabase
        .from("purchase_requests")
        .select("id, status")
        .eq("company_id", companyId)
        .in("status", ["submitted", "reviewing", "approved", "purchase_completed", "proof_submitted"])
        .is("deleted_at", null)

      const pendingPurchases = purchases?.filter(p =>
        ["submitted", "reviewing", "approved"].includes(p.status)
      ).length || 0

      // 환급신청 통계
      const { data: refunds } = await supabase
        .from("refund_applications")
        .select("id, status, approved_amount")
        .eq("company_id", companyId)
        .in("status", ["submitted", "reviewing", "approved", "processing", "completed"])
        .is("deleted_at", null)

      const pendingRefunds = refunds?.filter(r =>
        ["submitted", "reviewing", "approved", "processing"].includes(r.status)
      ).length || 0

      const totalRefundApproved = refunds?.filter(r => r.status === "completed")
        .reduce((sum, r) => sum + (r.approved_amount || 0), 0) || 0

      // 프로그램 참가 통계
      const { data: programs } = await supabase
        .from("program_applications")
        .select(`
          id,
          status,
          programs (
            id,
            name,
            starts_at,
            ends_at
          )
        `)
        .eq("applicant_id", (await supabase.auth.getUser()).data.user?.id || "")
        .in("status", ["approved", "completed"])
        .is("deleted_at", null)

      const activePrograms = programs?.filter((p: any) => {
        const now = new Date()
        const programData = Array.isArray(p.programs) ? p.programs[0] : p.programs
        const start = programData?.starts_at ? new Date(programData.starts_at) : null
        const end = programData?.ends_at ? new Date(programData.ends_at) : null
        return start && end && now >= start && now <= end && p.status === "approved"
      }) || []

      setStats({
        budget: totalBudget,
        purchase: pendingPurchases,
        refund: totalRefundApproved,
        programs: activePrograms.length,
      })

      // 최근 활동
      const activities: RecentActivity[] = []

      const { data: recentPurchases } = await supabase
        .from("purchase_requests")
        .select("id, item_name, status, created_at")
        .eq("company_id", companyId)
        .in("status", ["submitted", "reviewing", "approved", "purchase_completed", "proof_submitted"])
        .is("deleted_at", null)
        .order("created_at", { ascending: false })
        .limit(5)

      recentPurchases?.forEach(p => {
        activities.push({
          id: p.id,
          type: "purchase",
          title: `구매요청: ${p.item_name}`,
          status: p.status,
          date: p.created_at,
          link: `/portal/purchase-requests/${p.id}`,
        })
      })

      const { data: recentRefunds } = await supabase
        .from("refund_applications")
        .select("id, refund_recipient_name, status, created_at")
        .eq("company_id", companyId)
        .in("status", ["submitted", "reviewing", "approved", "processing", "completed"])
        .is("deleted_at", null)
        .order("created_at", { ascending: false })
        .limit(3)

      recentRefunds?.forEach(r => {
        activities.push({
          id: r.id,
          type: "refund",
          title: `환급신청: ${r.refund_recipient_name}`,
          status: r.status,
          date: r.created_at,
          link: `/portal/refunds/${r.id}`,
        })
      })

      activities.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
      setRecentActivities(activities.slice(0, 6))

      // 대기 업무 (검토 대기 중인 항목)
      const pending: PendingItem[] = []

      // 검토 대기 중인 구매요청
      const { data: pendingPurchasesItems } = await supabase
        .from("purchase_requests")
        .select("id, item_name, status, created_at")
        .eq("company_id", companyId)
        .in("status", ["submitted", "reviewing"])
        .is("deleted_at", null)
        .order("created_at", { ascending: false })
        .limit(5)

      pendingPurchasesItems?.forEach(p => {
        pending.push({
          id: p.id,
          type: "purchase",
          title: p.item_name,
          status: p.status,
          date: p.created_at,
          link: `/portal/purchase-requests/${p.id}`,
        })
      })

      // 검토 대기 중인 환급신청
      const { data: pendingRefundsItems } = await supabase
        .from("refund_applications")
        .select("id, refund_recipient_name, status, created_at")
        .eq("company_id", companyId)
        .in("status", ["submitted", "reviewing"])
        .is("deleted_at", null)
        .order("created_at", { ascending: false })
        .limit(5)

      pendingRefundsItems?.forEach(r => {
        pending.push({
          id: r.id,
          type: "refund",
          title: `환급: ${r.refund_recipient_name}`,
          status: r.status,
          date: r.created_at,
          link: `/portal/refunds/${r.id}`,
        })
      })

      pending.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
      setPendingItems(pending.slice(0, 5))

      // 예산 현황
      if (approvedBudgets.length > 0) {
        const { data: spentPurchases } = await supabase
          .from("purchase_requests")
          .select("approved_amount")
          .eq("company_id", companyId)
          .in("status", ["proof_approved", "completed"])
          .is("deleted_at", null)

        const spent = spentPurchases?.reduce((sum, p) => sum + (p.approved_amount || 0), 0) || 0

        setBudgetStatus({
          total: totalBudget,
          used: spent,
          remaining: totalBudget - spent,
        })
      }
    } catch (error) {
      console.error("대시보드 데이터 조회 실패:", error)
    } finally {
      setLoading(false)
    }
  }

  const getStatusBadge = (status: string) => {
    const badges: Record<string, { label: string; className: string }> = {
      "submitted": { label: "제출됨", className: "badge-neutral" },
      "reviewing": { label: "검토 중", className: "badge-neutral" },
      "approved": { label: "승인됨", className: "badge-success" },
      "rejected": { label: "반려됨", className: "badge-error" },
      "purchase_completed": { label: "구매 완료", className: "badge-success" },
      "proof_submitted": { label: "증빙 제출", className: "badge-neutral" },
      "completed": { label: "완료", className: "badge-success" },
      "processing": { label: "처리 중", className: "badge-warning" },
    }
    return badges[status] || { label: status, className: "badge-neutral" }
  }

  const getActivityIcon = (type: string) => {
    const icons = {
      "budget": <FileText className="w-4 h-4 text-pink-600" />,
      "purchase": <ShoppingCart className="w-4 h-4 text-purple-600" />,
      "refund": <RefreshCw className="w-4 h-4 text-emerald-600" />,
      "program": <Calendar className="w-4 h-4 text-orange-600" />,
    }
    return icons[type as keyof typeof icons] || <Clock className="w-4 h-4 text-gray-400" />
  }

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <div className="flex items-center gap-2 text-gray-400">
          <div className="w-4 h-4 border-2 border-pink-600 border-t-transparent rounded-full animate-spin" />
          <span>로딩 중...</span>
        </div>
      </div>
    )
  }

  const currentYear = new Date().getFullYear()

  return (
    <div className="space-y-8">
      {/* Welcome Banner */}
      <div className="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary via-primary to-primary-800 p-8 sm:p-10 shadow-primary-lg animate-slide-up">
        {/* Subtle gradient overlay */}
        <div className="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent"></div>
        {/* Decorative glow */}
        <div className="absolute top-0 right-0 w-80 h-80 bg-gradient-to-br from-white/10 to-transparent rounded-full blur-3xl"></div>
        <div className="absolute bottom-0 left-0 w-64 h-64 bg-gradient-to-tr from-white/5 to-transparent rounded-full blur-2xl"></div>,')] opacity-30"></div>
        <div className="relative">
          {/* Live status badge at top */}
          <div className="absolute -top-8 right-0">
            <div className="flex items-center gap-2 px-4 py-2 rounded-2xl bg-white/15 backdrop-blur-md border border-white/20">
              <div className="relative flex h-2 w-2">
                <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span className="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
              </div>
              <span className="text-white/90 text-xs font-semibold tracking-wide">실시간</span>
            </div>
          </div>

          <div className="flex items-start justify-between">
            <div className="space-y-4 pr-24">
              <div className="flex items-center gap-4">
                <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-white/20 backdrop-blur-md border-2 border-white/30">
                  <Building2 className="h-7 w-7 text-white" />
                </div>
                <div>
                  <p className="text-white/70 text-sm font-medium mb-1 tracking-wide">{currentYear}년도 사업 운영</p>
                  <h1 className="text-3xl sm:text-4xl font-bold text-white leading-tight">
                    {companyName || "기업명"}
                  </h1>
                </div>
              </div>
              <p className="text-white/90 text-base leading-relaxed max-w-2xl">
                예산, 구매, 환급, 프로그램 등 모든 사업 현황을 한눈에 확인하고 효율적으로 관리하세요.
              </p>

              {/* Quick stats pills */}
              <div className="flex flex-wrap gap-3 mt-6">
                <div className="flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 backdrop-blur-sm">
                  <FileText className="h-4 w-4 text-white/80" />
                  <span className="text-white/90 text-sm">예산 관리</span>
                </div>
                <div className="flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 backdrop-blur-sm">
                  <ShoppingCart className="h-4 w-4 text-white/80" />
                  <span className="text-white/90 text-sm">구매 요청</span>
                </div>
                <div className="flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 backdrop-blur-sm">
                  <RefreshCw className="h-4 w-4 text-white/80" />
                  <span className="text-white/90 text-sm">환급 신청</span>
                </div>
                <div className="flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 backdrop-blur-sm">
                  <Calendar className="h-4 w-4 text-white/80" />
                  <span className="text-white/90 text-sm">프로그램</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Pending Items Alert - 토스 스타일 */}
      {pendingItems.length > 0 && (
        <Card className="border-warning bg-warning-light/50 animate-slide-up stagger-1">
          <CardContent className="p-5">
            <div className="flex items-center gap-4">
              <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-warning-light">
                <AlertCircle className="h-6 w-6 text-warning" />
              </div>
              <div className="flex-1">
                <p className="text-sm font-semibold text-gray-900">
                  검토 대기 중인 요청이 <span className="font-bold text-warning">{pendingItems.length}</span>건 있습니다
                </p>
                <p className="text-xs text-gray-600 mt-1">
                  빠른 처리를 위해 확인 바랍니다
                </p>
              </div>
              <Link href="/portal/applications">
                <Button size="sm" className="rounded-xl bg-warning text-white hover:bg-warning/90">
                  확인하기
                  <ChevronRight className="h-4 w-4 ml-1" />
                </Button>
              </Link>
            </div>
          </CardContent>
        </Card>
      )}

      {/* Stats Grid */}
      <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <CardStat
          label="승인된 예산"
          value={stats.budget > 0 ? `${(stats.budget / 10000).toFixed(0)}만원` : "-"}
          icon={<DollarSign className="w-5 h-5" />}
          color="primary"
          className="animate-slide-up stagger-1"
        >
          <p className="text-xs text-gray-400 mt-1">{currentYear}년도</p>
        </CardStat>

        <CardStat
          label="진행 중 구매"
          value={stats.purchase}
          icon={<ShoppingCart className="w-5 h-5" />}
          color="purple"
          className="animate-slide-up stagger-2"
        >
          <p className="text-xs text-gray-400 mt-1">승인/집행 중</p>
        </CardStat>

        <CardStat
          label="환급받은 금액"
          value={stats.refund > 0 ? `${(stats.refund / 10000).toFixed(0)}만원` : "-"}
          icon={<RefreshCw className="w-5 h-5" />}
          color="emerald"
          className="animate-slide-up stagger-3"
        >
          <p className="text-xs text-gray-400 mt-1">누계</p>
        </CardStat>

        <CardStat
          label="참가 프로그램"
          value={stats.programs}
          icon={<Calendar className="w-5 h-5" />}
          color="orange"
          className="animate-slide-up stagger-4"
        >
          <p className="text-xs text-gray-400 mt-1">진행 중인 프로그램</p>
        </CardStat>
      </div>

      {/* Budget Status Card */}
      {budgetStatus && budgetStatus.total > 0 && (
        <Card className="animate-slide-up">
          <CardHeader>
            <div className="flex items-center justify-between">
              <div>
                <CardTitle>예산 사용 현황</CardTitle>
                <CardDescription>승인된 예산 대비 집행 현황</CardDescription>
              </div>
              <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-pink-50">
                <TrendingUp className="h-6 w-6 text-pink-600" />
              </div>
            </div>
          </CardHeader>
          <CardContent>
            <div className="space-y-5">
              <div className="flex items-end justify-between">
                <div>
                  <span className="text-sm text-gray-500">전체 예산</span>
                  <p className="text-2xl font-bold text-gray-900 mt-1">
                    {(budgetStatus.total / 10000).toFixed(0)}
                    <span className="text-base font-normal text-gray-500 ml-1">만원</span>
                  </p>
                </div>
                <div className="text-right">
                  <span className="text-sm text-gray-500">사용률</span>
                  <p className="text-lg font-semibold text-pink-600 mt-1">
                    {((budgetStatus.used / budgetStatus.total) * 100).toFixed(1)}%
                  </p>
                </div>
              </div>
              <div className="space-y-3">
                <div className="flex items-center justify-between text-sm">
                  <span className="text-gray-600 font-medium">집행 금액</span>
                  <span className="font-semibold text-gray-900">
                    {(budgetStatus.used / 10000).toFixed(0)}만원
                  </span>
                </div>
                <div className="h-3 w-full rounded-full bg-gray-100 overflow-hidden">
                  <div
                    className="h-full rounded-full bg-gradient-to-r from-pink-500 to-pink-600 transition-all duration-700 ease-out"
                    style={{ width: `${Math.min((budgetStatus.used / budgetStatus.total) * 100, 100)}%` }}
                  />
                </div>
                <div className="flex items-center justify-between text-sm">
                  <span className="text-gray-600 font-medium">잔여 예산</span>
                  <span className="font-semibold text-emerald-600">
                    {(budgetStatus.remaining / 10000).toFixed(0)}만원
                  </span>
                </div>
              </div>
            </div>
          </CardContent>
        </Card>
      )}

      <div className="grid gap-6 lg:grid-cols-2 animate-slide-up">
        {/* Recent Activity */}
        <Card>
          <CardHeader>
            <CardTitle>최근 활동</CardTitle>
            <CardDescription>최근 진행한 업무 현황</CardDescription>
          </CardHeader>
          <CardContent>
            {recentActivities.length > 0 ? (
              <div className="space-y-1.5">
                {recentActivities.map((activity) => {
                  const badge = getStatusBadge(activity.status)
                  return (
                    <Link
                      key={activity.id}
                      href={activity.link}
                      className="flex items-center gap-3 p-3 rounded-xl hover:bg-gray-50 transition-all duration-200 group"
                    >
                      <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gray-100 group-hover:bg-white group-hover:shadow-md transition-all">
                        {getActivityIcon(activity.type)}
                      </div>
                      <div className="flex-1 min-w-0">
                        <p className="text-sm font-medium text-gray-700 truncate">{activity.title}</p>
                        <p className="text-xs text-gray-400 mt-0.5">
                          {new Date(activity.date).toLocaleDateString("ko-KR", { month: "short", day: "numeric" })}
                        </p>
                      </div>
                      <Badge className={badge.className}>{badge.label}</Badge>
                    </Link>
                  )
                })}
              </div>
            ) : (
              <div className="text-center py-10">
                <div className="flex h-14 w-14 items-center justify-center rounded-full bg-gray-100 mx-auto mb-3">
                  <Clock className="w-7 h-7 text-gray-400" />
                </div>
                <p className="text-sm text-gray-500">최근 활동이 없습니다.</p>
                <p className="text-xs text-gray-400 mt-1">첫 요청을 시작해보세요</p>
              </div>
            )}
          </CardContent>
        </Card>

        {/* Quick Links */}
        <Card>
          <CardHeader>
            <CardTitle>빠른 링크</CardTitle>
            <CardDescription>자주 사용하는 기능</CardDescription>
          </CardHeader>
          <CardContent className="grid gap-2">
            <Link
              href="/portal/budgets"
              className="flex items-center gap-3 p-3.5 rounded-xl hover:bg-gray-50 transition-all duration-200 group border border-transparent hover:border-gray-200 hover:shadow-sm"
            >
              <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-pink-50 group-hover:bg-pink-100 transition-colors">
                <FileText className="w-5 h-5 text-pink-600" />
              </div>
              <div className="flex-1">
                <h3 className="font-semibold text-sm text-gray-900">예산관리</h3>
                <p className="text-xs text-gray-500 mt-0.5">예산서 작성 및 조회</p>
              </div>
              <ArrowRight className="w-5 h-5 text-gray-300 group-hover:text-pink-600 transition-colors" />
            </Link>

            <Link
              href="/portal/purchase-requests"
              className="flex items-center gap-3 p-3.5 rounded-xl hover:bg-gray-50 transition-all duration-200 group border border-transparent hover:border-gray-200 hover:shadow-sm"
            >
              <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-purple-50 group-hover:bg-purple-100 transition-colors">
                <ShoppingCart className="w-5 h-5 text-purple-600" />
              </div>
              <div className="flex-1">
                <h3 className="font-semibold text-sm text-gray-900">구매요청</h3>
                <p className="text-xs text-gray-500 mt-0.5">구매요청 작성 및 조회</p>
              </div>
              <ArrowRight className="w-5 h-5 text-gray-300 group-hover:text-purple-600 transition-colors" />
            </Link>

            <Link
              href="/portal/refunds"
              className="flex items-center gap-3 p-3.5 rounded-xl hover:bg-gray-50 transition-all duration-200 group border border-transparent hover:border-gray-200 hover:shadow-sm"
            >
              <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 group-hover:bg-emerald-100 transition-colors">
                <RefreshCw className="w-5 h-5 text-emerald-600" />
              </div>
              <div className="flex-1">
                <h3 className="font-semibold text-sm text-gray-900">환급신청</h3>
                <p className="text-xs text-gray-500 mt-0.5">환급신청 작성 및 조회</p>
              </div>
              <ArrowRight className="w-5 h-5 text-gray-300 group-hover:text-emerald-600 transition-colors" />
            </Link>

            <Link
              href="/portal/programs"
              className="flex items-center gap-3 p-3.5 rounded-xl hover:bg-gray-50 transition-all duration-200 group border border-transparent hover:border-gray-200 hover:shadow-sm"
            >
              <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-orange-50 group-hover:bg-orange-100 transition-colors">
                <Calendar className="w-5 h-5 text-orange-600" />
              </div>
              <div className="flex-1">
                <h3 className="font-semibold text-sm text-gray-900">프로그램</h3>
                <p className="text-xs text-gray-500 mt-0.5">프로그램 참가 신청</p>
              </div>
              <ArrowRight className="w-5 h-5 text-gray-300 group-hover:text-orange-600 transition-colors" />
            </Link>
          </CardContent>
        </Card>
      </div>

      {/* Help Banner - 토스 스타일 */}
      <Card className="bg-gradient-to-br from-primary to-secondary border-0 text-white shadow-primary-lg overflow-hidden animate-slide-up">
        {/* Subtle gradient overlay */}
        <div className="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent"></div>
        {/* Decorative glow */}
        <div className="absolute top-0 right-0 w-80 h-80 bg-gradient-to-br from-white/10 to-transparent rounded-full blur-3xl"></div>
        <div className="absolute bottom-0 left-0 w-64 h-64 bg-gradient-to-tr from-white/5 to-transparent rounded-full blur-2xl"></div>,PHN2ZyB3aWR0aD0iNDAiIGhlaWdodD0iNDAiIHZpZXdCb3g9IjAgMCA0MCA0MCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48ZyBmaWxsPSJub25lIiBmaWxsLXJ1bGU9ImV2ZW5vZGQiPjxjaXJjbGUgY3g9IjIwIiBjeT0iMjAiIHI9IjIiIGZpbGw9IiZmZmZmZmYiIGZpbGwtb3BhY2l0eT0iMC4xIi8+PC9nPjwvc3ZnPg==')] opacity-20"></div>
        <div className="absolute top-0 right-0 w-48 h-48 bg-gradient-to-br from-white/10 to-transparent rounded-full blur-2xl"></div>
        <CardContent className="p-6 relative">
          <div className="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6">
            <div className="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-white/20 backdrop-blur-sm">
              <HelpCircle className="w-8 h-8" />
            </div>
            <div className="flex-1">
              <h3 className="font-bold text-lg mb-1">도움이 필요하신가요?</h3>
              <p className="text-white/90 text-sm">
                우측 하단의 챗봇을 통해 실시간 문의가 가능하거나, 가이드라인을 확인하세요.
              </p>
            </div>
            <div className="flex gap-2 w-full sm:w-auto">
              <Link href="/portal/guidelines" className="flex-1 sm:flex-none">
                <Button size="default" className="bg-white text-primary hover:bg-white/90 w-full sm:w-auto rounded-xl shadow-sm">
                  가이드라인 보기
                </Button>
              </Link>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>
  )
}
